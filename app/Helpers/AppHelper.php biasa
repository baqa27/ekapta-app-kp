    public static function format_kelas_mahasiswa($kelas)
    {
        if (blank($kelas)) {
            return '-';
        }

        $normalized = Str::lower(trim((string) $kelas));

        if (in_array($normalized, ['a', 'reguler', 'regular', 'reguler_s1', 'reguler_d3'], true)) {
            return 'Reguler (A)';
        }

        if (in_array($normalized, ['b', 'karyawan'], true)) {
            return 'Karyawan (B)';
        }

        return (string) $kelas;
    }

