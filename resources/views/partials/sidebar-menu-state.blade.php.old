<script>
$(document).ready(function() {
    // Restore dropdown state from localStorage
    $('.nav-item.has-treeview').each(function() {
        var menuId = $(this).find('a:first p:first').text().trim();
        var isOpen = localStorage.getItem('sidebar_' + menuId);
        
        if (isOpen === 'open') {
            $(this).addClass('menu-open');
            $(this).find('> .nav-treeview').show();
        } else if (isOpen === 'closed') {
            $(this).removeClass('menu-open');
            $(this).find('> .nav-treeview').hide();
        }
        // If null, keep default state (based on active page)
    });

    // Save dropdown state when clicked
    $('.nav-item.has-treeview > a').on('click', function(e) {
        var $parent = $(this).parent();
        var menuId = $(this).find('p:first').text().trim();
        
        // Wait for AdminLTE to toggle the menu
        setTimeout(function() {
            if ($parent.hasClass('menu-open')) {
                localStorage.setItem('sidebar_' + menuId, 'open');
            } else {
                localStorage.setItem('sidebar_' + menuId, 'closed');
            }
        }, 100);
    });
});
</script>
